        <script><![CDATA[(function executeRule(current, previous) {

    var assignment = new GlideRecord(
        'x_1904737_smart_0_license_assignment'
    );

    if (assignment.get(current.getValue('license_assignment'))) {

        var usage = new GlideRecord(
            'x_1904737_smart_0_usage_record'
        );

        usage.addQuery(
            'license_assignment',
            current.getValue('license_assignment')
        );

        usage.orderByDesc('usage_date');
        usage.setLimit(1);
        usage.query();

        if (usage.next()) {

            assignment.setValue(
                'last_used_date',
                usage.getValue('usage_date')
            );

            assignment.update();
        }
    }

})(current, previous);]]></script>
