        <script><![CDATA[(function executeRule(current, previous) {

    g_scratchpad.showUsageWarning = false;
    g_scratchpad.usageMessage = '';

    var usageStatus = current.getValue('usage_status');

    if (usageStatus == 'low_usage') {

        g_scratchpad.showUsageWarning = true;
        g_scratchpad.usageMessage =
            'Warning: This license has low usage and may require renewal review.';

    } else if (usageStatus == 'inactive') {

        g_scratchpad.showUsageWarning = true;
        g_scratchpad.usageMessage =
            'Warning: This license is inactive and may be a cost-saving opportunity.';

    } else if (usageStatus == 'never_used') {

        g_scratchpad.showUsageWarning = true;
        g_scratchpad.usageMessage =
            'Warning: This license has never been used.';

    }

})(current, previous);]]></script>
